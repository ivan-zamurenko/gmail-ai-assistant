{
  "schema_version": 1,
  "stages": {
    "S00": {
      "title": "Принятие проекта и инструменты",
      "description": "Безопасное принятие нового bot/extension baseline, две воспроизводимые установки, сохранённые security tests, CI и инструкции агентов."
    },
    "S01": {
      "title": "Приоритетные защитные исправления",
      "description": "Dry Run без Drive mutations, проверка target/origin, безопасные ошибки, bounded retries и совместимое хранение настроек."
    },
    "S02": {
      "title": "Идентификаторы, неоднозначность и именование",
      "description": "Проверяемые barcode/text parsers. Существование номера не доказывает его принадлежность изображению или автору письма."
    },
    "S03": {
      "title": "Проверяемые depot действия",
      "description": "HTML/lookup, подтверждённые calendar/status policy, настоящий preview и защищённое применение формы. Реальные изменения не выполняются в локальных тестах."
    },
    "S04": {
      "title": "Надёжная пакетная обработка Drive",
      "description": "Folder scope, актуальный filing plan, execution context, durable journal, cancel/recovery и отдельный тестовый roundtrip."
    },
    "S05": {
      "title": "Gmail от очереди до подтверждённого draft",
      "description": "Pagination, MIME, проверенный case context, reply policy и draft с recovery. Автоматической отправки в этом плане нет."
    },
    "S06": {
      "title": "Контролируемый AI",
      "description": "Provider выбирает владелец; schema и hostile synthetic cases можно проверить заранее. Live shadow требует отдельных разрешений и бюджета. OWNER-D01: каждый ответ проверяет человек; S06-05 связывает proposal с подтверждённым draft."
    },
    "S07": {
      "title": "Понятный и устойчивый интерфейс",
      "description": "Фактические состояния, capabilities, клавиатура и ошибки. Не менять язык интерфейса или стек только ради соответствия примеру."
    },
    "S08": {
      "title": "Браузерная проверка и согласованный выпуск",
      "description": "Проверка Chrome, совместимых bot/extension/rules, чистого артефакта и разрешённого пилота. Не заменяет live evidence документом."
    },
    "S09": {
      "title": "Discord-бот и общая очередь Firestore",
      "description": "Перевірка й укріплення чинного Discord-бота, all/parcel/barcodes/retry, контрактів, доступів і доставки результатів."
    }
  },
